  m_Script: {fileID: 11500000, guid: bc1c2ba155c3d5c4ab960ecfc990c120, type: 3}
  m_Name: Story_PcAccept
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speaker: "\uC0AC\uC7A5"
    text: "\uC774\uC0C1\uD55C \uC758\uB8B0\uC774\uC9C0 \uC54A\uC740\uAC00? \uACE0\uC791
      \uC720\uB9AC\uBCD1 3\uAC1C\uC5D0 5000\uB9CC \uACE8\uB4DC\uB77C\uB2C8!"
  - speaker: "\uC0AC\uC7A5"
    text: "\uC0C8 PC \uC7A5\uB9CC\uD55C \uC9C0 \uC5BC\uB9C8\uB098 \uB410\uB2E4\uACE0
      \uBC8C\uC368 \uACE0\uC7A5\uB09C\uAC74 \uC544\uB2C8\uACA0\uC9C0?"
  - speaker: "\uC0AC\uC7A5"
    text: "\uC790\uB124\uAC00 \uD655\uC778\uD558\uB7EC \uAC00\uC904 \uC218 \uC788\uACA0\uB098?"
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "(\uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4.)"
  - speaker: "\uC0AC\uC7A5"
    text: "\uC88B\uC544, \uADF8\uB7FC\u2026 \uC77C\uB2E8 \uC758\uB8B0\uB294 \uC811\uC218\uD574\uB193\uACA0\uB124.
      \uAC00\uC11C \uD655\uC778\uD574 \uBCF4\uAC8C."
