%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bc1c2ba155c3d5c4ab960ecfc990c120, type: 3}
  m_Name: Story_LeonTalk
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - speaker: "\uB808\uC628"
    text: "\uB4DC\uB514\uC5B4\u2026! \uAC10\uC0AC\uD569\uB2C8\uB2E4, \uAC10\uC0AC\uD569\uB2C8\uB2E4\u2026!
      \uBB38 \uC55E\uC5D0 \uC788\uB358 \uBAAC\uC2A4\uD130\uB294\u2026 \uD574\uCE58\uC6B0\uC2E0
      \uAC74\uAC00\uC694?"
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "(\uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4.)"
  - speaker: "\uB808\uC628"
    text: "\uC57D\uC18D\uB4DC\uB9B0 \uBCF4\uC218\uB294\u2026 \uBAA8\uB4E0 \uC758\uB8B0\uAC00
      \uB05D\uB09C \uD6C4, \uC774 \uBC29\uC5D0 \uC788\uB294 \uBCF4\uBB3C\uB4E4\uB85C
      \uB4DC\uB9B4\uAC8C\uC694. \uC544\uBB34\uAC70\uB098 \uC9D1\uC5B4 \uAC00\uC154\uB3C4
      5000\uB9CC \uACE8\uB4DC \uAC12\uC740 \uD560 \uAC81\uB2C8\uB2E4."
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "\u2018\uBAA8\uB4E0 \uC758\uB8B0?\u2019"
  - speaker: "\uB808\uC628"
    text: "(\uC7A0\uC2DC \uC228\uC744 \uACE0\uB978 \uB4A4, \uB4A4\uD3B8\uC5D0 \uC788\uB294
      \uC561\uCCB4\uB97C \uC720\uB9AC\uBCD1\uC5D0 \uB2F4\uAE30 \uC2DC\uC791\uD55C\uB2E4.)"
  - speaker: "\uB808\uC628"
    text: "\uC774\uAC74\u2026 \uC544\uBB34\uB9AC \uD070 \uBD80\uC0C1\uC744 \uC785\uC740
      \uC0AC\uB78C\uC774\uB77C\uB3C4 \uCE58\uB8CC\uD560 \uC218 \uC788\uB294 \uC601\uC57D\uC785\uB2C8\uB2E4."
  - speaker: "\uB808\uC628"
    text: "\uC800\uB294 \uBA70\uCE60 \uC804, \uC6B0\uC5F0\uD788 \uBCF4\uBB3C \uC9C0\uB3C4\uB97C
      \uBC1C\uACAC\uD574\uC11C\u2026 \uC774 \uC601\uC57D\uC744 \uCC3E\uAE30 \uC704\uD574
      \uB3D9\uB8CC\uB4E4\uACFC \uD568\uAED8 \uB358\uC804\uC5D0 \uB4E4\uC5B4\uC654\uC5B4\uC694."
  - speaker: "\uB808\uC628"
    text: "\uD558\uC9C0\uB9CC \uBCF4\uC2A4\uC5D0\uAC8C \uC2B5\uACA9\uBC1B\uB294 \uBC14\uB78C\uC5D0\u2026
      \uB3D9\uB8CC\uB4E4\uACFC \uBFD4\uBFD4\uC774 \uD769\uC5B4\uC9C0\uACE0 \uB9D0\uC558\uC5B4\uC694.
      \uBD84\uBA85 \uBAA8\uB450 \uD06C\uAC8C \uB2E4\uCCE4\uC744 \uAC81\uB2C8\uB2E4."
  - speaker: "\uB808\uC628"
    text: "\uC800\uB294 \uC5B4\uB5BB\uAC8C\uB4E0 \uC774\uACF3\uAE4C\uC9C0 \uB3C4\uB9DD\uCCD0
      \uC654\uC9C0\uB9CC\u2026 \uC774 \uB358\uC804\uC758 \uBAAC\uC2A4\uD130\uB4E4\uC740
      \uC81C \uC2E4\uB825\uC73C\uB85C\uB294 \uAC10\uB2F9\uD558\uAE30\uAC00 \uC5B4\uB835\uB354\uAD70\uC694."
  - speaker: "\uB808\uC628"
    text: "\uB3D9\uB8CC\uB4E4\uC5D0\uAC8C \uC9C1\uC811 \uC804\uB2EC\uD558\uB7EC \uB098\uAC00\uB294
      \uAC74 \uBB34\uB9AC\uC77C \uAC83 \uAC19\uC544\uC694\u2026"
  - speaker: "\uB808\uC628"
    text: "\uC5FC\uCE58\uC5C6\uB294 \uBD80\uD0C1\uC778 \uAC74 \uC54C\uC9C0\uB9CC\u2026
      \uC774 \uC601\uC57D\uC744 \uB2F4\uC740 \uC720\uB9AC\uBCD1\uC744 \uC81C \uB3D9\uB8CC\uB4E4\uC5D0\uAC8C
      \uC804\uB2EC\uD574 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
  - speaker: "\uB808\uC628"
    text: "\uADF8\uB4E4\uC774 \uC544\uC9C1 \uC0B4\uC544 \uC788\uB2E4\uBA74\u2026
      \uC774 \uC601\uC57D\uC774 \uBD84\uBA85 \uD070 \uB3C4\uC6C0\uC774 \uB420 \uAC81\uB2C8\uB2E4."
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "(\uACE0\uAC1C\uB97C \uB044\uB355\uC778\uB2E4.)"
  - speaker: "\uB808\uC628"
    text: "\uC815\uB9D0 \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - speaker: "\uD50C\uB808\uC774\uC5B4"
    text: "(\uC720\uB9AC\uBCD1\uC5D0 \uC561\uCCB4\uB97C \uBAA8\uB450 \uB2F4\uB294\uB2E4.)"
